{
  "_meta": {
    "phase": "4E.1",
    "purpose": "Gold semantics (intent / explicit filters / preferences) for the minimal query-semantics spike. Written from the query text alone, before the parser existed. The Phase 4D dataset (agent_cases.json) is not modified; reused queries are copied and marked in `source`.",
    "expected_contract": "consultant.query_semantics.QuerySemantics (validated with QuerySemantics.from_dict)",
    "fields": {
      "expected": "exact gold semantics; `intent` null = not a catalog request",
      "acceptable_extra_preferences": "preferences that are defensible but not required (not counted as wrong)",
      "forbidden_filters": "filter fields that must never appear for this query (false-constraint traps); every filter not in `expected` is already counted as invented",
      "trap": "mandatory false-constraint trap A-E from the 4E.1 brief"
    }
  },
  "cases": [
    {"id": "ef-oled-under-100k", "group": "explicit_filters", "source": "4e1-brief",
     "query": "Хочу OLED до 100 тысяч.",
     "expected": {"intent": "recommendation", "filters": {"panel_technology": ["OLED"], "max_price": 100000}, "preferences": []}},
    {"id": "ef-4k-65", "group": "explicit_filters", "source": "new",
     "query": "Нужен 4K телевизор на 65 дюймов.",
     "expected": {"intent": "recommendation", "filters": {"resolution": ["4K"], "screen_size_inches": 65}, "preferences": []}},
    {"id": "ef-min-55", "group": "explicit_filters", "source": "4e1-brief",
     "query": "Подберите телевизор не меньше 55 дюймов.",
     "expected": {"intent": "recommendation", "filters": {"min_screen_size_inches": 55}, "preferences": []}},
    {"id": "ef-120hz-under-150k", "group": "explicit_filters", "source": "4e1-brief",
     "query": "Посоветуй телевизор со 120 Гц до 150 тысяч.",
     "expected": {"intent": "recommendation", "filters": {"min_refresh_rate_hz": 120, "max_price": 150000}, "preferences": []}},
    {"id": "ef-neo-qled-75", "group": "explicit_filters", "source": "4d:search-neo-qled-75",
     "query": "Есть Neo QLED на 75 дюймов?",
     "expected": {"intent": "catalog_question", "filters": {"panel_technology": ["Neo QLED"], "screen_size_inches": 75}, "preferences": []}},

    {"id": "pref-ps5", "group": "preferences", "source": "4d:rec-gaming", "trap": "A",
     "query": "Посоветуй телевизор для PS5.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["gaming"]},
     "forbidden_filters": ["min_refresh_rate_hz"]},
    {"id": "pref-movies", "group": "preferences", "source": "4d:rec-movies",
     "query": "Какой телевизор лучше всего для фильмов?",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["movies"]}},
    {"id": "pref-football", "group": "preferences", "source": "4e1-brief",
     "query": "Нужен телевизор, чтобы смотреть футбол.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["sports"]}},
    {"id": "pref-bright-room", "group": "preferences", "source": "4d:rec-bright-room", "trap": "B",
     "query": "Какой телевизор лучше для очень светлой комнаты?",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["bright_room"]}},
    {"id": "pref-picture", "group": "preferences", "source": "4e1-brief",
     "query": "Главное для меня — качество картинки.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["picture_quality"]},
     "forbidden_filters": ["resolution"]},

    {"id": "trap-powerful-sound", "group": "false_constraint_trap", "source": "4e1-brief", "trap": "C",
     "query": "Хочу телевизор с мощным звуком.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["audio"]}},
    {"id": "trap-cheap", "group": "false_constraint_trap", "source": "4e1-brief", "trap": "D",
     "query": "Посоветуй недорогой телевизор.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": []},
     "forbidden_filters": ["min_price", "max_price"]},
    {"id": "trap-large", "group": "false_constraint_trap", "source": "4e1-brief", "trap": "E",
     "query": "Хочу большой телевизор в гостиную.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": []},
     "forbidden_filters": ["screen_size_inches", "min_screen_size_inches", "max_screen_size_inches"]},
    {"id": "trap-bright-screen", "group": "false_constraint_trap", "source": "4e1-brief",
     "query": "Нужен телевизор с ярким экраном.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["picture_quality"]},
     "acceptable_extra_preferences": ["bright_room"]},

    {"id": "mix-mandatory", "group": "mixed", "source": "4e1-brief", "trap": "A",
     "query": "Хочу 65-дюймовый OLED до 150 тысяч для PS5 и кино, чтобы звук был хороший.",
     "expected": {"intent": "recommendation",
                  "filters": {"screen_size_inches": 65, "panel_technology": ["OLED"], "max_price": 150000},
                  "preferences": ["gaming", "movies", "audio"]},
     "forbidden_filters": ["min_refresh_rate_hz"]},
    {"id": "mix-explicit-hz-ps5", "group": "mixed", "source": "new",
     "query": "Нужен телевизор для PS5 со 120 Гц и HDMI 2.1, до 120 тысяч.",
     "expected": {"intent": "recommendation", "filters": {"min_refresh_rate_hz": 120, "max_price": 120000},
                  "preferences": ["gaming"]},
     "note": "Positive control: 120 Hz is stated, so it is a filter. HDMI 2.1 is stated too, but the minimal contract has no feature field; it must stay unstructured (raw query), not become another filter."},
    {"id": "mix-not-oled", "group": "mixed", "source": "4e1-brief",
     "query": "Посоветуй телевизор на 55 дюймов, только не OLED.",
     "expected": {"intent": "recommendation", "filters": {"screen_size_inches": 55}, "preferences": []},
     "forbidden_filters": ["panel_technology"],
     "note": "The contract cannot express an exclusion; a positive OLED filter would invert the request."},
    {"id": "mix-oled-optional", "group": "mixed", "source": "4e1-brief",
     "query": "Нужен телевизор для кино, OLED не принципиален.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["movies"]},
     "forbidden_filters": ["panel_technology"]},

    {"id": "cmp-s90h-s95h", "group": "comparison", "source": "4e1-brief",
     "query": "S90H или S95H?",
     "expected": {"intent": "comparison", "filters": {"models": ["S90H", "S95H"]}, "preferences": []}},
    {"id": "cmp-ps5-s85h-s90h", "group": "comparison", "source": "4e1-brief", "trap": "A",
     "query": "Что лучше для PS5: S85H или S90H?",
     "expected": {"intent": "comparison", "filters": {"models": ["S85H", "S90H"]}, "preferences": ["gaming"]},
     "forbidden_filters": ["min_refresh_rate_hz"]},

    {"id": "pq-refresh-s95h", "group": "product_question", "source": "4e1-brief",
     "query": "Какая частота обновления у S95H?",
     "expected": {"intent": "product_question", "filters": {"models": ["S95H"]}, "preferences": []},
     "forbidden_filters": ["min_refresh_rate_hz"],
     "note": "Asking about an attribute is not a constraint on it."},
    {"id": "pq-games-code", "group": "product_question", "source": "4e1-brief", "trap": "A",
     "query": "Подходит ли QE65S95HAUXPY для игр?",
     "expected": {"intent": "product_question", "filters": {"models": ["QE65S95HAUXPY"]}, "preferences": ["gaming"]},
     "forbidden_filters": ["min_refresh_rate_hz"]},
    {"id": "pq-family-size", "group": "product_question", "source": "4d:get-tv-family-size",
     "query": "Сколько стоит S95H на 55 дюймов?",
     "expected": {"intent": "product_question", "filters": {"models": ["S95H"], "screen_size_inches": 55}, "preferences": []}},

    {"id": "cat-oled-models", "group": "catalog_question", "source": "4e1-brief",
     "query": "Какие OLED модели есть?",
     "expected": {"intent": "catalog_question", "filters": {"panel_technology": ["OLED"]}, "preferences": []}},
    {"id": "cat-count-under-70k", "group": "catalog_question", "source": "4e1-brief",
     "query": "Сколько моделей дешевле 70 тысяч есть в наличии?",
     "expected": {"intent": "catalog_question", "filters": {"max_price": 70000, "availability": "available"}, "preferences": []}},
    {"id": "cat-cheapest", "group": "catalog_question", "source": "4d:stats-cheapest",
     "query": "Какой самый дешёвый телевизор?",
     "expected": {"intent": "catalog_question", "filters": {}, "preferences": []},
     "forbidden_filters": ["min_price", "max_price"],
     "note": "A superlative is an ordering, not a price bound."},

    {"id": "col-plojka", "group": "colloquial", "source": "4e1-brief", "trap": "A",
     "query": "Нужен телек под плойку.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["gaming"]},
     "forbidden_filters": ["min_refresh_rate_hz"]},
    {"id": "col-daylight", "group": "colloquial", "source": "4e1-brief", "trap": "B",
     "query": "Чтобы днём картинка не была блеклой.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["bright_room"]},
     "acceptable_extra_preferences": ["picture_quality"]},
    {"id": "col-no-speakers", "group": "colloquial", "source": "4e1-brief",
     "query": "Хочется нормальный звук без отдельной акустики.",
     "expected": {"intent": "recommendation", "filters": {}, "preferences": ["audio"]},
     "note": "'без отдельной акустики' negates the external speaker, not the audio need."},

    {"id": "oos-oled-explainer", "group": "out_of_scope", "source": "4d:no-tool-oled-explainer",
     "query": "Объясни простыми словами, что такое OLED.",
     "expected": {"intent": null, "filters": {}, "preferences": []},
     "forbidden_filters": ["panel_technology"],
     "note": "A general explanation, not a catalog request (4D no_tool family). The four-intent vocabulary has no slot for it; null = no catalog intent."}
  ]
}
