# Copy to consultant.env on the VPS (chmod 600). Never commit the real file.
# Read-only least-privilege role, reached over the internal Docker network by service name.
CONSULTANT_DATABASE_URL=postgresql://samsung_consultant:<generated-on-vps>@postgres:5432/samsung_rag
# Shared secret for n8n -> MCP (n8n Header Auth credential: "Authorization: Bearer <token>").
CONSULTANT_MCP_TOKEN=<generated-on-vps>
CONSULTANT_MAX_TOOL_CALLS_PER_TURN=3
