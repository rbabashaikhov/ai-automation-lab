DATABASE_URL=postgresql://n8n:your_password@127.0.0.1:5432/samsung_rag

# Indexing pipeline (projects/ai-catalog-consultant/indexing/): a separate,
# least-privilege role scoped only to documents/chunks (+ read-only
# products/product_specs) -- see README.md "Database access". Never reuses
# the samsung_ingestion or n8n role's own credential.
INDEXING_DATABASE_URL=postgresql://samsung_indexing:your_password@127.0.0.1:5432/samsung_rag

# Optional overrides -- sensible defaults are baked into ingestion/config.py
# SAMSUNG_CATALOG_URL=https://galaxystore.ru/catalog/televizory/year=2026/
# SAMSUNG_SOURCE=galaxystore
# SAMSUNG_DELAY_SECONDS=2.0
# SAMSUNG_MAX_RETRIES=4
# SAMSUNG_BACKOFF_BASE_SECONDS=1.0
# SAMSUNG_REQUEST_TIMEOUT_SECONDS=20.0
